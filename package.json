{
  "name": "setun",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite dev",
    "build": "bun --bun vite build && bun run build:sandbox",
    "build:sandbox": "bun --bun vite build --config sandbox/vite.config.ts && SETUN_SANDBOX_BUILD_TARGET=runtimes bun --bun vite build --config sandbox/vite.config.ts && SETUN_SANDBOX_BUILD_TARGET=compiler bun --bun vite build --config sandbox/vite.config.ts",
    "dev:sandbox": "bun --bun vite dev --config sandbox/vite.config.ts",
    "preview:sandbox": "bun --bun vite preview --config sandbox/vite.config.ts",
    "preview": "bun --bun vite preview",
    "start": "bun ./server.js",
    "recover:educator": "bun ./scripts/recover-educator.ts",
    "prepare": "test -f project.inlang/settings.json || exit 0; paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide && svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && bun run check:native",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "biome ci",
    "format": "biome check --write",
    "test:component": "vitest run --project client && vitest run --project server",
    "test:e2e": "playwright test",
    "check:python": "bash .github/scripts/check-python.sh",
    "check:native": "bunx --bun svelte-check --tsgo --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/merge": "6.12.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@inlang/paraglide-js": "2.25.4",
    "@internationalized/date": "3.12.4",
    "@lezer/highlight": "1.2.3",
    "@lucide/svelte": "1.47.0",
    "@playwright/test": "1.63.0",
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/bun": "1.4.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@unocss/preset-wind4": "66.10.5",
    "@unocss/runtime": "66.10.5",
    "@vitest/browser-playwright": "5.0.1",
    "bits-ui": "2.19.2",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "dompurify": "3.4.15",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.3",
    "esbuild-wasm": "0.28.2",
    "marked": "18.0.14",
    "playwright": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn-svelte": "1.7.0",
    "shiki": "4.4.3",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "sveltekit-superforms": "2.30.2",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "3.3.1",
    "typescript": "6.0.3",
    "unocss": "66.10.5",
    "unocss-preset-animations": "1.3.0",
    "unocss-preset-shadcn": "1.0.1",
    "valibot": "1.5.0",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "vitest-browser-svelte": "3.1.0",
    "@typescript/native": "npm:typescript@7.0.2"
  },
  "dependencies": {
    "jspdf": "4.2.1",
    "qrcode": "1.5.4",
    "svg2pdf.js": "2.8.1"
  },
  "packageManager": "bun@1.4.2"
}
