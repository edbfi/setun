# Setun environment (PRD §6.2). Copy to `.env` and fill every value.
# Absence of a required variable fails boot with a clear message rather than
# starting degraded — that validation lands with the server entry in Phase 1.

# Pepper for the student access-code HMAC-SHA-256 digest. High-entropy, secret,
# and permanent: changing it invalidates every existing access code (§7).
SETUN_STUDENT_CODE_PEPPER=

# Educator account, seeded at boot. OPTIONAL, and a pair: set both, or neither.
#
# Left blank, the first boot prints a one-time setup token to the container log
# and sends every request to /setup, where the wizard collects the credential and
# creates the first model alias and classroom. This is the easier path for a new
# installation (§6.2).
#
# Filled in, Setun seeds the account at boot and there is no wizard. Changing the
# pair and restarting remains a recovery path. An operator-assisted CLI recovery
# supersedes the unchanged pair so a later restart cannot silently undo it (§7).
SETUN_EDUCATOR_SEED_USERNAME=
SETUN_EDUCATOR_SEED_PASSWORD=

# Listener key shared between Setun and CPA. Must equal the value under
# `api-keys:` in cpa/config.yaml — that is the only thing authenticating the
# gateway, which has no public endpoint (§9).
SETUN_CPA_LISTENER_KEY=

# Public URL of the application origin: the address people open in the
# browser, with its scheme and (if not the default) port, and no path. Setun
# prints it on access slips and QR codes, and it is the app's public origin:
# Compose passes it to `bun ./server.js` as ORIGIN, which states it to
# SvelteKit's origin check on every request. ORIGIN alone works as well; when
# both are set, ORIGIN wins.
#
# Required. Over plain HTTP, use the http:// address, for example
# http://192.168.1.10:3000. Behind an HTTPS reverse proxy that passes the
# original Host (Caddy in docker-compose.yml), use the https:// address. With
# neither this nor ORIGIN set, the server stops at startup and says so; only
# `bun run dev` falls back to http://localhost:5173.
SETUN_APP_ORIGIN=https://setun.example.org

# Public URL of the sandbox origin, including scheme. Must be a different host
# from the application origin — artifacts are isolated by origin, not by path (§14).
SETUN_SANDBOX_ORIGIN=https://artifacts.setun.example.org

# Hostnames Caddy answers on, without scheme. Normally the hosts of the two URLs above.
SETUN_APP_HOSTNAME=setun.example.org
SETUN_SANDBOX_HOSTNAME=artifacts.setun.example.org

# Contact address for ACME certificate issuance. Leave empty on a closed network
# and switch each site block in the Caddyfile to `tls internal` (§6.2).
SETUN_ACME_EMAIL=

# Where attachments and generated images are written. Outside any web root:
# nothing serves this directory, and every read goes through an owner-scoped
# endpoint (§15, §21). Compose mounts a volume here.
SETUN_STORAGE_PATH=/data/storage

# Where the SQLite database file lives. One file; Compose mounts a volume here.
SETUN_DATABASE_PATH=/data/db/setun.sqlite

# Where the nightly snapshot job writes: a `VACUUM INTO` copy of the database
# plus a copy of the storage directory, last 14 days retained (§21, Appendix A).
# A separate volume from the database, so losing one does not lose the other.
SETUN_BACKUP_PATH=/data/backups

# Optional second place to write the one-time first-run setup token (§6.2).
#
# The container log is always written and is the channel meant for a human. This
# file exists for an operator running detached who has already scrolled past the
# banner. It is written with mode 0600 and deleted the moment setup completes.
#
# Leave it unset unless you need it, and never point it inside the storage or
# backup volume, where the nightly snapshot would copy it.
SETUN_BOOTSTRAP_TOKEN_PATH=

# The on-disk MCP server configuration (§11) — the third operator file, beside
# the Compose file and this one. Copy mcp.example.json to mcp.json, edit it, and
# mount it at this path. Leave unset to run without MCP; a classroom with no
# tools is a valid deployment.
SETUN_MCP_CONFIG_PATH=/config/mcp.json

# Credentials referenced by name from the MCP configuration file. One variable per
# credential that file names; they never enter the database and never reach the
# browser (§11). Rename this placeholder to match whatever mcp.json references.
SETUN_MCP_EXAMPLE_TOKEN=

# The largest request body the application accepts.
#
# An artifact is a small project of files, and a pupil restoring an older
# revision posts its whole file list. `src/lib/artifacts/project.ts` caps a
# project at 1 MB, so anything at or above that is enough; the Bun adapter's own
# default is 512 KB, which a project of a few large files reaches. Compose
# passes this value as BODY_SIZE_LIMIT; leave it unset for 2M. A server started
# by hand reads BODY_SIZE_LIMIT itself (below), also 2M by default.
SETUN_BODY_SIZE_LIMIT=

# --- Server settings for `bun ./server.js` run without Compose (optional) ---
#
# docker-compose.yml sets these for its own deployment, and Compose passes only
# the variables it names. A server started by hand reads its environment, which
# Bun also fills from a `.env` in the working directory.
#
# ORIGIN: the same as SETUN_APP_ORIGIN above, which it overrides when both are set.
# ORIGIN=http://192.168.1.10:3000
#
# Behind a reverse proxy, so the per-address login and rate limits see each
# pupil's address rather than the proxy's. Set them only when every request
# passes through the proxy; XFF_DEPTH is the number of proxies (default 1).
# Compose sets both for its Caddy.
# ADDRESS_HEADER=x-forwarded-for
# XFF_DEPTH=1
#
# PROTOCOL_HEADER and HOST_HEADER are only for deployments without ORIGIN.
# Setun always has an origin (above), and its front replaces them: leave them unset.
#
# Seconds a stopping server lets open requests, such as a streaming answer,
# finish: 30 by default, and 7 in the container image so that it fits inside
# the 10 seconds `docker stop` waits.
# SHUTDOWN_TIMEOUT=30
#
# The largest request body (2M by default; see SETUN_BODY_SIZE_LIMIT above).
# BODY_SIZE_LIMIT=2M
