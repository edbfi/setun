{
  // SvelteKit 3 writes `$app/tsconfig` during `svelte-kit sync`. It already sets allowJs,
  // checkJs, esModuleInterop, forceConsistentCasingInFileNames, resolveJsonModule,
  // skipLibCheck, moduleResolution "bundler", verbatimModuleSyntax and isolatedModules.
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "rewriteRelativeImportExtensions": true,
    "sourceMap": true,
    "strict": true,
    // `bun test` suites import `bun:test`; server modules use `bun:sqlite` and `Bun.*`.
    // `$app/types` must stay: it carries SvelteKit's ambient module declarations.
    "types": ["bun", "$app/types"],
    // SvelteKit 3 no longer generates `$lib`; it is an explicit alias, declared here and in
    // vite.config.ts's `resolve.alias`.
    "paths": {
      "$lib": ["./src/lib"],
      "$lib/*": ["./src/lib/*"]
    }
  },
  // `$app/tsconfig` sets no `include`, so the type-check scope is stated in full: the app,
  // the Playwright suite and the separate-origin sandbox host.
  "include": [
    "./.svelte-kit/types/**/$types.d.ts",
    "./vite.config.ts",
    "./uno.config.ts",
    "./playwright.config.ts",
    "./src/**/*.js",
    "./src/**/*.ts",
    "./src/**/*.svelte",
    "./e2e/**/*.ts",
    "./sandbox/**/*.ts"
  ]
}
